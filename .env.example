# ============================================================
# Sentinel Gujarat — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in REAL values.
# NEVER commit .env to Git.
# ============================================================

# ----------------------------------------------------------
# SENTINEL SANDBOX — Official Infrastructure (Integrator's Guide)
# ----------------------------------------------------------
SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
SENTINEL_RTSP_HOST=103.250.160.189
SENTINEL_RTSP_PORT=8554

# Authenticated RTSP ingestion credentials (per Integrator's Guide)
# The @ in the email is automatically URL-encoded by the application
SENTINEL_RTSP_EMAIL=you@example.com
SENTINEL_RTSP_PASSWORD=your_rtsp_password_here

SENTINEL_WEBRTC_HOST=103.250.160.189
SENTINEL_WEBRTC_PORT=8889
SENTINEL_HLS_HOST=cctv.corp8.cloud

# Complete Cookie header value from browser DevTools to authenticate cameras.json
# Example: SENTINEL_CATALOGUE_COOKIE=sentinel=your_session_cookie_here
# DO NOT commit real credentials.
SENTINEL_CATALOGUE_COOKIE=
# Optional/unused — Sentinel CDN uses Cookie authentication, not Bearer token.
SENTINEL_CATALOGUE_TOKEN=

# Legacy fields (kept for backward compatibility)
SENTINEL_BASE_URL=https://cctv.corp8.cloud
SENTINEL_INGEST_ENDPOINT=/cameras.json

# ----------------------------------------------------------
# RTSP SETTINGS
# ----------------------------------------------------------
# Always use TCP as required by the Sentinel integration rules.
RTSP_TRANSPORT=tcp

# How many seconds to wait for a frame before considering the stream dead.
RTSP_FRAME_TIMEOUT_SEC=10

# ----------------------------------------------------------
# DATABASE (not needed for Milestone 1)
# ----------------------------------------------------------
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://sentinel_user:changeme@localhost:5432/sentinel_gujarat

# ----------------------------------------------------------
# SECURITY (not needed for Milestone 1)
# ----------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ----------------------------------------------------------
# GOOGLE MAPS (not needed until GIS milestone)
# ----------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

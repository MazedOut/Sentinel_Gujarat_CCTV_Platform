# =============================================================
#  Sentinel Gujarat — .gitignore
# =============================================================

# ── Secrets & credentials ────────────────────────────────────
.env
.env.*
*.key
*.pem
*.pfx
*.p12
cookies.txt
scratch_cookies.txt

# ── Python ───────────────────────────────────────────────────
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.local

# ── AI model weights & large binaries ────────────────────────
*.pt
*.onnx
*.tflite
*.engine
*.torchscript
ai/models/*.pt
ai/models/*.onnx

# ── ANPR & Evidence ──────────────────────────────────────────
evidence/
detection_samples/

# ── Logs & Temporary Scrapes ─────────────────────────────────
*.log
logs/
catalogue_download.json
live_grid_page.html
resource_page.html
backend/app/services/streaming/cache/

# ── Database ─────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
sentinel_gujarat.db
postgres_data/

# ── Backup folders ───────────────────────────────────────────
backup-before-hardening/
frontend/backup/

# ── IDE & OS files ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# ── Docker volumes ───────────────────────────────────────────
docker-volumes/

# ── Misc temporary ───────────────────────────────────────────
*.bak
*.tmp
*.orig
